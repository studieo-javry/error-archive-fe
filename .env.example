# ── 로컬 개발 템플릿 ─────────────────────────────────────────────
# 이 파일을 .env.development 로 복사해서 값을 채운다.
# VITE_* 는 전부 빌드 타임에 번들로 들어가 브라우저에 노출된다 = 비밀이 아니다.
# 진짜 비밀(GitHub OAuth Client Secret 등)은 BE 에만 존재한다.

# MSW 목 사용 여부. true 면 BE 없이 단독 실행된다.
VITE_OFFLINE_MODE=true

# 비워두면 상대경로 /api/v1 → vite.config.ts 의 proxy 가 localhost:8000 으로 전달.
# 프로덕션은 CI 가 GitHub Variables 에서 주입한다 (예: https://api.error-archive.com/api/v1).
VITE_API_BASE_URL=

# GitHub OAuth App 의 Client ID. 설계상 공개값이다.
VITE_GITHUB_CLIENT_ID=

VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
