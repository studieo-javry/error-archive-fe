{
  "name": "error-archive-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:single": "VITE_OFFLINE_MODE=true vite build --config vite.singlefile.config.ts && node scripts/inline-singlefile.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "axios": "^1.16.0",
    "highlight.js": "^11.11.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "msw": "^2.15.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7",
    "wrangler": "^4.124.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
