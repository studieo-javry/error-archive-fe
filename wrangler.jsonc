{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "error-archive-fe",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/p/*"]
  },
  "observability": { "enabled": true }
}
